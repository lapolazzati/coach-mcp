# Coach config. Copy to /opt/coach/.env on the Hetzner box, chmod 600.
# Never commit the real file or paste its values in chat.

# --- Needed for go-live ---
# intervals.icu → Settings → Developer Settings
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=            # e.g. i123456

# Garmin Connect Web → Personal API Key → Create Key (shown once; note its expiry)
GARMIN_PERSONAL_API_KEY=
GARMIN_PERSONAL_API_KEY_EXPIRES= # YYYY-MM-DD, so the coach can warn before it lapses

# --- Runtime ---
COACH_DB_PATH=/opt/coach/data/coach.sqlite
COACH_TZ=Europe/Rome
COACH_BIND_HOST=                 # the box's Tailscale IP (100.x.y.z), never 0.0.0.0
COACH_BIND_PORT=8000

# --- Later units (leave empty for now) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_BUDGET_USD=100
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SA_JSON=                  # service-account JSON, inline on one line (domain-wide delegation)
GOOGLE_SUBJECT=l@ethon.io
GOOGLE_CALENDAR_IDS=primary      # comma-separated
GOOGLE_MAPS_API_KEY=
COACH_HOME_ADDRESS=
